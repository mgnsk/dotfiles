#!/bin/env bash

set -eu

args=(
	--unshare-all
	--unshare-user
	--disable-userns
	--share-net
	--die-with-parent
	--cap-drop ALL

	--setenv USERHOST_COLOR '\[\e[0;33m\]'

	# Discard so that we get a fresh tmp.
	--unsetenv TMPDIR
	--unsetenv TMP

	--dev /dev
	--proc /proc
	--tmpfs /tmp
	--tmpfs "$XDG_RUNTIME_DIR"

	--ro-bind /bin /bin
	--ro-bind /usr /usr
	--ro-bind /lib /lib
	--ro-bind /lib64 /lib64
	--ro-bind /nix /nix
	--ro-bind /etc/resolv.conf /etc/resolv.conf
	--ro-bind /etc/hosts /etc/hosts
	--ro-bind /etc/ssl /etc/ssl
	--ro-bind /etc/ca-certificates /etc/ca-certificates
	--ro-bind /etc/passwd /etc/passwd
	--ro-bind /etc/group /etc/group

	--ro-bind "$HOME/.gitconfig_local" "$HOME/.gitconfig_local"
	--ro-bind-try "$HOME/.ssh/known_hosts" "$HOME/.ssh/known_hosts"

	--bind "$HOME/go" "$HOME/go"
	--bind "$PWD" "$PWD"
)

# Detect current git project root.
# Falls back to HOME (the dotfiles repo) when
# outside of a specific repo.
project=$(git rev-parse --show-toplevel)
volume_name="${project//\//_}-$(echo -n "$project" | sha256sum | cut -c1-8)"

# Start the SSH agent confirmation proxy. Sandboxed processes only ever
# see this proxy's socket, never the real one - every sign request
# (SSH auth, commit signing) is gated behind a tmux popup confirmation.
agent_proxy_dir=$(mktemp -d)
agent_proxy_sock="$agent_proxy_dir/agent.sock"
"$(dirname "$0")/ssh-agent-guard" "$HOME/.1password/agent.sock" "$agent_proxy_sock" &
agent_proxy_pid=$!

for _ in $(seq 1 50); do
	[[ -S "$agent_proxy_sock" ]] && break
	sleep 0.1
done

args+=(
	--bind "$agent_proxy_sock" "$HOME/.1password/agent.sock"
)

# Start a private, ephemeral D-Bus session bus with a fake Secret Service
# on it, so sandboxed gh can store its auth token there instead of in
# plaintext in ~/.config/gh/hosts.yml. Sandboxed processes only ever see
# this bus's socket, never a real session bus - this is NOT the same as
# the xdg-dbus-proxy setup this repo used to have (removed in 368b084),
# which forwarded the *real* session bus into the sandbox. The secrets
# database lives outside the sandbox and is never bind-mounted in, only
# the D-Bus socket is, so it can only be reached through the Secret
# Service API.
secrets_dir=$(mktemp -d)
secrets_bus_sock="$secrets_dir/bus.sock"
secrets_bus_conf="$secrets_dir/bus.conf"
secrets_ready="$secrets_dir/ready"
secrets_db="$HOME/.ide/$volume_name/secrets.sqlite3"
mkdir -p "$(dirname "$secrets_db")"

cat >"$secrets_bus_conf" <<EOF
<!DOCTYPE busconfig PUBLIC "-//freedesktop//DTD D-Bus Bus Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/dbus/1.0/busconfig.dtd">
<busconfig>
  <type>session</type>
  <listen>unix:path=$secrets_bus_sock</listen>
  <auth>EXTERNAL</auth>
  <policy context="default">
    <allow send_destination="*" eavesdrop="true"/>
    <allow eavesdrop="true"/>
    <allow own="*"/>
  </policy>
</busconfig>
EOF

dbus-daemon --config-file="$secrets_bus_conf" --nofork --nopidfile &
secrets_bus_pid=$!

"$(dirname "$0")/secret-service-guard" "unix:path=$secrets_bus_sock" "$secrets_db" "$secrets_ready" &
secrets_guard_pid=$!

trap 'kill "$agent_proxy_pid" "$secrets_bus_pid" "$secrets_guard_pid" 2>/dev/null; rm -rf "$agent_proxy_dir" "$secrets_dir"' EXIT

for _ in $(seq 1 50); do
	[[ -S "$secrets_bus_sock" ]] && break
	sleep 0.1
done
for _ in $(seq 1 50); do
	[[ -e "$secrets_ready" ]] && break
	sleep 0.1
done

args+=(
	--bind "$secrets_bus_sock" "$XDG_RUNTIME_DIR/bus"
	--setenv DBUS_SESSION_BUS_ADDRESS "unix:path=$XDG_RUNTIME_DIR/bus"
)

if [[ "$project" == "$HOME" ]]; then
	args+=(
		--bind "$HOME/.git" "$HOME/.git"
		--setenv GIT_DISCOVERY_ACROSS_FILESYSTEM 1
	)
	# Read-write bind all files tracked by dotfiles git.
	for f in $(git -C "$HOME" ls-tree -r master --name-only); do
		args+=(
			--bind "$HOME/$f" "$HOME/$f"
		)
	done
else
	# Read-only bind all files tracked by dotfiles git.
	for f in $(git -C "$HOME" ls-tree -r master --name-only); do
		args+=(
			--ro-bind "$HOME/$f" "$HOME/$f"
		)
	done
fi

function add_volume() {
	container_path="$1"

	host_path="$HOME/.ide/$volume_name/$container_path"

	# Detect if path is a directory (ends with /) or file
	if [[ "$container_path" == */ ]]; then
		mkdir -p "$host_path"
	else
		mkdir -p "$(dirname "$host_path")"
		touch "$host_path"
	fi

	args+=(
		--bind "$host_path" "$container_path"
	)
}

# Create per-project persistent volumes.
add_volume "$HOME/.cache/"
add_volume "$HOME/.claude.json"
add_volume "$HOME/.claude/"
add_volume "$HOME/.config/gh/"
add_volume "$HOME/.gemini/"
add_volume "$HOME/.local/state/"
add_volume "$HOME/.npm/"

args+=(
	bash
)

bwrap "${args[@]}"
