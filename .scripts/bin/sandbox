#!/bin/env bash

set -e

args=(
	--unshare-all
	--share-net
	--die-with-parent
	--cap-drop ALL

	--setenv USERHOST_COLOR '\[\e[0;33m\]'

	# Discard so that we get a fresh tmp.
	--unsetenv TMPDIR
	--unsetenv TMP

	# Allow nested tmux in sandbox.
	--unsetenv TMUX
	--unsetenv TMUX_PANE

	--dev /dev
	--proc /proc
	--tmpfs /tmp
	--tmpfs "$XDG_RUNTIME_DIR"

	--ro-bind "/bin" "/bin"
	--ro-bind "/usr" "/usr"
	--ro-bind "/lib" "/lib"
	--ro-bind "/lib64" "/lib64"
	--ro-bind "/etc" "/etc"
	--ro-bind "/nix" "/nix"
	--ro-bind "/opt" "/opt"

	--ro-bind "$HOME/.1password" "$HOME/.1password"
	--ro-bind "$HOME/.gitconfig_local" "$HOME/.gitconfig_local"

	--bind "$HOME/go" "$HOME/go"
	--bind "$PWD" "$PWD"
)

# Detect current git project root.
# Falls back to HOME (the dotfiles repo) when
# outside of a specific repo.
project=$(git rev-parse --show-toplevel)

if [[ "$project" == "$HOME" ]]; then
	args+=(
		--bind "$HOME/.git" "$HOME/.git"
		--setenv GIT_DISCOVERY_ACROSS_FILESYSTEM 1
	)
	# Read-write bind all files tracked by dotfiles git.
	for f in $(git -C "$HOME" ls-tree -r master --name-only); do
		args+=(
			--bind "$HOME/$f" "$HOME/$f"
		)
	done
else
	# Read-only bind all files tracked by dotfiles git.
	for f in $(git -C "$HOME" ls-tree -r master --name-only); do
		args+=(
			--ro-bind "$HOME/$f" "$HOME/$f"
		)
	done
fi

function add_volume() {
	container_path="$1"

	# Replace every (//) slash (\/) with underscore (_) and append a unique hash.
	volume_name="${project//\//_}-$(echo -n "$project" | sha256sum | cut -c1-8)"

	host_path="$HOME/.ide/$volume_name/$container_path"

	# Detect if path is a directory (ends with /) or file
	if [[ "$container_path" == */ ]]; then
		mkdir -p "$host_path"
	else
		mkdir -p "$(dirname "$host_path")"
		touch "$host_path"
	fi

	args+=(
		--bind "$host_path" "$container_path"
	)
}

# Create per-project persistent volumes.
add_volume "$HOME/.cache/"
add_volume "$HOME/.claude.json"
add_volume "$HOME/.claude/"
add_volume "$HOME/.config/gh/"
add_volume "$HOME/.gemini/"
add_volume "$HOME/.local/state/"
add_volume "$HOME/.npm/"

args+=(
	bash
)

bwrap "${args[@]}"
