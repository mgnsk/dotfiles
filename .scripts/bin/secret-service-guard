#!/bin/env python3
"""Fake org.freedesktop.secrets D-Bus service for the sandbox.

Runs outside the sandbox, connected to a private, ephemeral D-Bus bus that
bin/sandbox starts just for this purpose. Persists secrets in a sqlite3
database on the host; the sandboxed process only ever sees this D-Bus
socket, never the database file, since only the socket - never the sqlite
path - gets bind-mounted in.

Any sandboxed process that stores credentials via libsecret/Secret Service
gets real persistence instead of falling back to plaintext files - gh's
go-keyring backend was the motivating case, but the same bus works for
Docker credential helpers, `npm login`, Python `keyring`, and anything
else that speaks the protocol.

Implements just enough of the Secret Service spec for those clients to
work: OpenSession("plain"), Unlock (always succeeds, no master password),
Collection.SearchItems/CreateItem on a single fixed collection,
Item.GetSecret/Delete. The Prompt object/signal dance is never triggered
because Unlock/CreateItem/Delete always return the null prompt path "/".
"""

import asyncio
import json
import os
import sqlite3
import sys

from dbus_next import Variant
from dbus_next.aio import MessageBus
from dbus_next.service import PropertyAccess, ServiceInterface, dbus_property, method

SERVICE_NAME = "org.freedesktop.secrets"
SERVICE_PATH = "/org/freedesktop/secrets"
COLLECTION_PATH = "/org/freedesktop/secrets/aliases/default"
ITEM_PATH_PREFIX = "/org/freedesktop/secrets/item/"
NULL_PATH = "/"

ITEM_IFACE = "org.freedesktop.Secret.Item"


class Store:
    """sqlite3-backed item store.

    WAL mode plus a busy timeout so that multiple concurrent sandbox
    invocations for the same project don't corrupt or deadlock on
    each other.
    """

    def __init__(self, path):
        # Create the file ourselves at 0600 first: sqlite3.connect() offers no
        # mode control, so under the usual 0022 umask it would land at 0644 -
        # world-readable, for a file that stores credentials (gh's OAuth token
        # among them) in plaintext. O_CREAT's mode is ignored when the file
        # already exists, hence the explicit chmod for databases created
        # before this. SQLite gives the -wal and -shm sidecars the database
        # file's own mode, so fixing it here covers those too.
        os.close(os.open(path, os.O_RDWR | os.O_CREAT, 0o600))
        os.chmod(path, 0o600)
        self._conn = sqlite3.connect(path, timeout=30)
        self._conn.execute("PRAGMA journal_mode=WAL")
        self._conn.execute(
            """
            CREATE TABLE IF NOT EXISTS items (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                label TEXT NOT NULL,
                attributes TEXT NOT NULL,
                content_type TEXT NOT NULL,
                secret BLOB NOT NULL
            )
            """
        )
        self._conn.commit()

    def all_rows(self):
        """Return every stored (row_id, label, attributes, content_type, secret)."""
        cur = self._conn.execute("SELECT id, label, attributes, content_type, secret FROM items")
        return [
            (row_id, label, json.loads(attrs), content_type, bytes(secret))
            for row_id, label, attrs, content_type, secret in cur.fetchall()
        ]

    def find_by_attributes(self, attributes):
        """Return the row id of the item with exactly these attributes, if any."""
        for row_id, _label, attrs, _content_type, _secret in self.all_rows():
            if attrs == attributes:
                return row_id
        return None

    def upsert(self, label, attributes, content_type, secret, replace):
        """Insert a new item, or update the matching one in place if replace is set."""
        row_id = self.find_by_attributes(attributes) if replace else None
        if row_id is not None:
            self._conn.execute(
                "UPDATE items SET label = ?, content_type = ?, secret = ? WHERE id = ?",
                (label, content_type, secret, row_id),
            )
            self._conn.commit()
            return row_id
        cur = self._conn.execute(
            "INSERT INTO items (label, attributes, content_type, secret) VALUES (?, ?, ?, ?)",
            (label, json.dumps(attributes, sort_keys=True), content_type, secret),
        )
        self._conn.commit()
        return cur.lastrowid

    def get(self, row_id):
        """Return (content_type, secret) for a stored item."""
        cur = self._conn.execute("SELECT content_type, secret FROM items WHERE id = ?", (row_id,))
        row = cur.fetchone()
        if row is None:
            raise KeyError(row_id)
        content_type, secret = row
        return content_type, bytes(secret)

    def delete(self, row_id):
        """Delete a stored item."""
        self._conn.execute("DELETE FROM items WHERE id = ?", (row_id,))
        self._conn.commit()


def item_path(row_id):
    """D-Bus object path for a stored item."""
    return f"{ITEM_PATH_PREFIX}{row_id}"


class ItemIface(ServiceInterface):
    """org.freedesktop.Secret.Item - one instance exported per stored item."""

    def __init__(self, store, row_id):
        super().__init__(ITEM_IFACE)
        self._store = store
        self._row_id = row_id

    @method(name="GetSecret")
    def get_secret(self, session: "o") -> "(oayays)":
        """Return this item's secret, framed as an unencrypted Secret struct."""
        content_type, secret = self._store.get(self._row_id)
        return [session, b"", secret, content_type]

    @method(name="Delete")
    def delete(self) -> "o":
        """Delete this item and report no prompt needed."""
        self._store.delete(self._row_id)
        return NULL_PATH


class CollectionIface(ServiceInterface):
    """org.freedesktop.Secret.Collection - the single fixed default collection this fake service exposes."""

    def __init__(self, bus, store):
        super().__init__("org.freedesktop.Secret.Collection")
        self._bus = bus
        self._store = store
        self._exported = set()

    def export_item(self, row_id):
        """Export the D-Bus object for a stored item, once per process lifetime."""
        if row_id in self._exported:
            return
        self._exported.add(row_id)
        self._bus.export(item_path(row_id), ItemIface(self._store, row_id))

    @method(name="SearchItems")
    def search_items(self, attributes: "a{ss}") -> "ao":
        """Return items whose attributes are a superset of the given ones."""
        paths = []
        for row_id, _label, attrs, _content_type, _secret in self._store.all_rows():
            if attributes.items() <= attrs.items():
                self.export_item(row_id)
                paths.append(item_path(row_id))
        return paths

    @method(name="CreateItem")
    def create_item(self, properties: "a{sv}", secret: "(oayays)", replace: "b") -> "oo":
        """Store an item, replacing any existing one with the same attributes."""
        label = properties[f"{ITEM_IFACE}.Label"].value
        attributes = properties[f"{ITEM_IFACE}.Attributes"].value
        _session, _params, value, content_type = secret
        row_id = self._store.upsert(label, attributes, content_type, bytes(value), replace)
        self.export_item(row_id)
        return [item_path(row_id), NULL_PATH]


class ServiceIface(ServiceInterface):
    """org.freedesktop.Secret.Service - the always-unlocked, no-password fake service."""

    def __init__(self):
        super().__init__("org.freedesktop.Secret.Service")
        self._session_seq = 0

    @method(name="OpenSession")
    def open_session(self, _algorithm: "s", _client_input: "v") -> "vo":
        """Open a "plain" (unencrypted) session - the only algorithm supported."""
        self._session_seq += 1
        return [Variant("s", ""), f"/org/freedesktop/secrets/session/s{self._session_seq}"]

    @method(name="Unlock")
    def unlock(self, objects: "ao") -> "aoo":
        """Report everything as already unlocked, with no prompt required."""
        return [objects, NULL_PATH]

    @dbus_property(access=PropertyAccess.READ, name="Collections")
    def collections(self) -> "ao":
        """Deliberately empty, so go-keyring falls back to aliases/default directly."""
        return []


async def main():
    """Connect to the given private bus and serve the fake secret service forever."""
    bus_address, db_path, ready_path = sys.argv[1], sys.argv[2], sys.argv[3]
    store = Store(db_path)

    bus = await MessageBus(bus_address=bus_address).connect()

    collection = CollectionIface(bus, store)
    bus.export(SERVICE_PATH, ServiceIface())
    bus.export(COLLECTION_PATH, collection)
    for row_id, *_rest in store.all_rows():
        collection.export_item(row_id)

    await bus.request_name(SERVICE_NAME)
    with open(ready_path, "w", encoding="utf-8"):
        pass

    await asyncio.get_event_loop().create_future()


if __name__ == "__main__":
    asyncio.run(main())
