#!/bin/env python3
"""SSH agent proxy that gates every sign request behind a tmux popup.

Sits between a sandboxed client and the real SSH agent socket. Identity
listing is forwarded untouched; sign requests (SSH auth, commit signing)
only reach the real agent after the user approves a tmux popup prompt.
Every other request type is refused outright - see FORWARDABLE.
"""

import base64
import hashlib
import os
import shlex
import socket
import struct
import subprocess
import sys
import tempfile
import threading
import uuid

SSH_AGENTC_REQUEST_IDENTITIES = 11
SSH_AGENT_IDENTITIES_ANSWER = 12
SSH_AGENTC_SIGN_REQUEST = 13
SSH_AGENT_FAILURE = 5

# The only two request types that ever reach the real agent. Everything else
# is answered with SSH_AGENT_FAILURE here and never forwarded: the rest of the
# protocol *mutates* the agent, and this proxy's whole job is to keep the
# sandbox from reaching past it. Notably that blocks SSH_AGENTC_LOCK (22),
# which would otherwise let a sandboxed process lock the user's real agent
# with a password of its choosing, and REMOVE_IDENTITY/REMOVE_ALL_IDENTITIES
# (18/19), ADD_IDENTITY (17/25), the smartcard calls (20/21/26) and the
# open-ended SSH_AGENTC_EXTENSION channel (27) - none of which were gated
# before, since only sign requests were being checked.
#
# Safe against normal use: ssh(1) treats a refused session-bind@openssh.com
# extension as non-fatal, and `ssh-add -l` / `ssh-keygen -Y sign` (git's ssh
# commit signing) only ever send the two types below.
FORWARDABLE = frozenset({SSH_AGENTC_REQUEST_IDENTITIES, SSH_AGENTC_SIGN_REQUEST})

IDENTITY_COMMENTS = {}
IDENTITY_LOCK = threading.Lock()


def recv_exact(sock, n):
    """Read exactly n bytes from sock, or None if it closes early."""
    buf = b""
    while len(buf) < n:
        chunk = sock.recv(n - len(buf))
        if not chunk:
            return None
        buf += chunk
    return buf


def read_frame(sock):
    """Read one length-prefixed SSH agent protocol message, or None at EOF."""
    hdr = recv_exact(sock, 4)
    if hdr is None:
        return None
    (length,) = struct.unpack(">I", hdr)
    payload = recv_exact(sock, length)
    if payload is None:
        return None
    return payload


def write_frame(sock, payload):
    """Write one length-prefixed SSH agent protocol message."""
    sock.sendall(struct.pack(">I", len(payload)) + payload)


def read_uint32(buf, offset):
    """Read a big-endian uint32 from buf at offset. Returns (value, new_offset)."""
    return struct.unpack_from(">I", buf, offset)[0], offset + 4


def read_string(buf, offset):
    """Read a length-prefixed byte string from buf at offset. Returns (value, new_offset)."""
    length, offset = read_uint32(buf, offset)
    end = offset + length
    if end > len(buf):
        raise struct.error("string length exceeds buffer")
    return buf[offset:end], end


def fingerprint(key_blob):
    """SHA256 fingerprint of a key blob, formatted like `ssh-keygen -lf`."""
    digest = hashlib.sha256(key_blob).digest()
    return "SHA256:" + base64.b64encode(digest).decode("ascii").rstrip("=")


def cache_identities(payload):
    """Parse an identities-answer response and cache fingerprint -> comment.

    Best-effort: this is display enrichment, not part of the security
    boundary, so any parse failure is swallowed and simply leaves the
    cache unchanged.
    """
    try:
        offset = 1
        nkeys, offset = read_uint32(payload, offset)
        for _ in range(nkeys):
            key_blob, offset = read_string(payload, offset)
            comment, offset = read_string(payload, offset)
            with IDENTITY_LOCK:
                IDENTITY_COMMENTS[fingerprint(key_blob)] = comment.decode("utf-8", "replace")
    except (struct.error, IndexError):
        pass


def peer_pid(sock):
    """PID of the process on the other end of a connected AF_UNIX socket."""
    creds = sock.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i"))
    pid, _uid, _gid = struct.unpack("3i", creds)
    return pid


def peer_cwd(pid):
    """Best-effort cwd of pid, read from the host's /proc."""
    try:
        return os.readlink(f"/proc/{pid}/cwd")
    except OSError:
        return "unknown"


def peer_cmdline(pid):
    """Best-effort command line of pid, read from the host's /proc."""
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            raw = f.read()
    except OSError:
        return "unknown"
    parts = raw.split(b"\0")
    if parts and parts[-1] == b"":
        parts.pop()
    if not parts:
        return "unknown"
    return " ".join(shlex.quote(p.decode("utf-8", "replace")) for p in parts)


def describe_peer(sock):
    """(cwd, cmdline) of sock's peer, sampled while it still holds the connection.

    SO_PEERCRED gives an authentic pid, but only as of connect() - and /proc
    here is the *host's*. Sampling it lazily, at the moment a sign request
    needs a popup, means a peer that has since exited may have had its pid
    reused by an unrelated host process, and that process's command line
    would then be what the popup attributes the request to. Reading it once
    up front, while the peer is provably alive on the other end, keeps the
    popup describing the process that actually opened the connection.
    """
    try:
        pid = peer_pid(sock)
    except OSError:
        return "unknown", "unknown"
    return peer_cwd(pid), peer_cmdline(pid)


def clean(s, limit=200):
    """Strip non-printable chars (e.g. ANSI escapes) and truncate for safe display.

    Applied to every field sourced from the sandboxed side before it is
    written out for the popup to display, so a crafted comment can't spoof
    or hide popup content via terminal escape sequences.
    """
    s = "".join(c if c.isprintable() else "?" for c in s)
    return s if len(s) <= limit else s[:limit] + "…"


def confirm_via_tmux(cwd, cmdline, key_comment):
    """Block on a tmux popup asking to approve a sign request.

    Returns False immediately, without showing a popup, if there's no
    tmux session to show it in or the popup fails to display.

    All request-derived text is written to a file and merely `cat`, never
    interpolated into the popup's shell command string - that command runs
    on the host outside the sandbox, so untrusted text (comment, cwd)
    must never be treated as shell syntax there.
    """
    if "TMUX" not in os.environ:
        return False

    channel = f"ssh-agent-guard-{uuid.uuid4().hex}"
    marker = info_path = None
    try:
        marker_fd, marker = tempfile.mkstemp(prefix="ssh-agent-guard-marker-")
        os.close(marker_fd)

        info_fd, info_path = tempfile.mkstemp(prefix="ssh-agent-guard-info-")
        with os.fdopen(info_fd, "w", encoding="utf-8") as f:
            f.write("Allow SSH agent to sign?\n\n")
            f.write(f"  cwd:      {clean(cwd)}\n")
            f.write(f"  command:  {clean(cmdline)}\n")
            f.write(f"  comment:  {clean(key_comment or 'unknown')}\n")

        popup_cmd = (
            f"cat {shlex.quote(info_path)}; "
            f'read -p "[y/N] " a; '
            f'if [[ "$a" == [yY] ]]; then echo yes > {shlex.quote(marker)}; fi; '
            f"tmux wait-for -S {channel}"
        )

        with subprocess.Popen(["tmux", "display-popup", "-E", "-w", "76", popup_cmd]) as popup:

            def watch_popup():
                # If display-popup fails to even launch (e.g. no attached
                # tmux client), it exits non-zero without ever running
                # popup_cmd, so the "wait-for -S" signal below would never
                # fire. Signal it ourselves so we don't hang forever.
                if popup.wait() != 0:
                    subprocess.run(["tmux", "wait-for", "-S", channel], check=False)

            threading.Thread(target=watch_popup, daemon=True).start()

            subprocess.run(["tmux", "wait-for", channel], check=False)
        with open(marker, encoding="utf-8") as f:
            return f.read().strip() == "yes"
    finally:
        if marker:
            os.unlink(marker)
        if info_path:
            os.unlink(info_path)


def handle_client(client, upstream_path):
    """Relay one client connection to the upstream agent.

    Only FORWARDABLE request types are relayed at all, and sign requests
    among them only after the user approves the popup; everything else is
    answered with SSH_AGENT_FAILURE without upstream ever seeing the frame.
    """
    cwd, cmdline = describe_peer(client)

    try:
        upstream = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        upstream.connect(upstream_path)
    except OSError:
        client.close()
        return

    try:
        while True:
            payload = read_frame(client)
            if payload is None:
                break
            if not payload:
                continue

            msg_type = payload[0]

            if msg_type not in FORWARDABLE:
                write_frame(client, bytes([SSH_AGENT_FAILURE]))
                continue

            if msg_type == SSH_AGENTC_SIGN_REQUEST:
                try:
                    key_blob, _ = read_string(payload, 1)
                    key_fp = fingerprint(key_blob)
                except (struct.error, IndexError):
                    key_fp = "unknown"
                with IDENTITY_LOCK:
                    key_comment = IDENTITY_COMMENTS.get(key_fp)
                if not confirm_via_tmux(cwd, cmdline, key_comment):
                    write_frame(client, bytes([SSH_AGENT_FAILURE]))
                    continue

            write_frame(upstream, payload)
            response = read_frame(upstream)
            if response is None:
                break
            is_identities_answer = response and response[0] == SSH_AGENT_IDENTITIES_ANSWER
            if msg_type == SSH_AGENTC_REQUEST_IDENTITIES and is_identities_answer:
                cache_identities(response)
            write_frame(client, response)
    except OSError:
        pass
    finally:
        client.close()
        upstream.close()


def main():
    """Listen on argv[2], proxying each connection to argv[1]."""
    upstream_path = sys.argv[1]
    listen_path = sys.argv[2]

    if os.path.exists(listen_path):
        os.unlink(listen_path)

    server = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    server.bind(listen_path)
    server.listen(5)

    while True:
        client, _ = server.accept()
        threading.Thread(
            target=handle_client, args=(client, upstream_path), daemon=True
        ).start()


if __name__ == "__main__":
    main()
