+// Regression test for wine/yabridge's nested Vulkan/GL "client window":
+// wine reparents that child into its plugin GUI's embedded HWND *before*
+// that HWND itself gets reparented into REAPER's (tracked) container. The
+// child must not be destroyed just because its intended parent isn't a
+// tracked, rendered window yet - it should become a real wl_subsurface once
+// its parent is.
+#[test]
+fn embedded_child_reparented_before_parent_ready() {
+    let (mut f, compositor) = TestFixture::new_with_compositor();
+
+    let parent_window = Window::new(1);
+    let child_window = Window::new(2);
+
+    let (child_buffer, child_surface) = compositor.create_surface();
+    let child_data = WindowData {
+        mapped: true,
+        dims: WindowDims {
+            x: 5,
+            y: 5,
+            width: 30,
+            height: 40,
+        },
+        fullscreen: false,
+    };
+    f.new_window(child_window, false, child_data);
+
+    // Mirrors the xstate ReparentNotify handler's non-root branch: the
+    // child's own X client reparented it into `parent_window`, which
+    // satellite isn't tracking as a rendered window yet.
+    f.satellite.set_embedded_parent(child_window, parent_window);
+
+    // The child gets mapped and its wl_surface associated (SetSerial)
+    // while its real parent still doesn't exist as far as satellite knows.
+    f.map_window(&compositor, child_window, &child_surface.obj, &child_buffer);
+    f.run();
+
+    let child_id = f.check_new_surface();
+    {
+        let surface_data = f.testwl.get_surface_data(child_id).unwrap();
+        assert!(
+            surface_data.role.is_none(),
+            "child should have no role yet, waiting on its parent: {:?}",
+            surface_data.role
+        );
+    }
+
+    // The buffer attach from `map_window` (analogous to DXVK's real
+    // Present-driven content, as opposed to `compositor.create_surface`'s
+    // own unrelated setup attach) must have been queued rather than
+    // forwarded - assigning a role after content was already committed
+    // without one would be a protocol violation.
+    assert!(
+        f.connection().windows.contains_key(&child_window),
+        "sanity: child window still tracked, not destroyed"
+    );
+
+    // The parent now becomes a real toplevel - analogous to REAPER's plugin
+    // container finally embedding wine's window.
+    let (_parent_surface, parent_id) = f.create_toplevel(&compositor, parent_window);
+    f.run();
+
+    let surface_data = f.testwl.get_surface_data(child_id).unwrap();
+    let Some(testwl::SurfaceRole::Subsurface(sub)) = &surface_data.role else {
+        panic!("child should now be a subsurface: {:?}", surface_data.role);
+    };
+    assert_eq!(sub.parent, parent_id);
+    assert_eq!(sub.position, testwl::Vec2 { x: 5, y: 5 });
+    assert!(
+        surface_data.buffer.is_some(),
+        "queued buffer attach should have been flushed on promotion"
+    );
+}
+
+// Same scenario, but the child's parent is already a tracked, rendered
+// window by the time the child is reparented into it - the common case,
+// which should skip the pending state entirely and embed immediately.
+#[test]
+fn embedded_child_parent_already_ready() {
+    let (mut f, compositor) = TestFixture::new_with_compositor();
+
+    let parent_window = Window::new(1);
+    let (_parent_surface, parent_id) = f.create_toplevel(&compositor, parent_window);
+
+    let child_window = Window::new(2);
+    let (child_buffer, child_surface) = compositor.create_surface();
+    let child_data = WindowData {
+        mapped: true,
+        dims: WindowDims {
+            x: 3,
+            y: 4,
+            width: 20,
+            height: 20,
+        },
+        fullscreen: false,
+    };
+    f.new_window(child_window, false, child_data);
+    f.satellite.set_embedded_parent(child_window, parent_window);
+    f.map_window(&compositor, child_window, &child_surface.obj, &child_buffer);
+    f.run();
+
+    let child_id = f.check_new_surface();
+    let surface_data = f.testwl.get_surface_data(child_id).unwrap();
+    let Some(testwl::SurfaceRole::Subsurface(sub)) = &surface_data.role else {
+        panic!("child should be an immediate subsurface: {:?}", surface_data.role);
+    };
+    assert_eq!(sub.parent, parent_id);
+    assert_eq!(sub.position, testwl::Vec2 { x: 3, y: 4 });
+}
