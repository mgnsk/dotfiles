diff --git i/meson.build w/meson.build
index 12ecb974..d513bd61 100644
--- i/meson.build
+++ w/meson.build
@@ -218,7 +218,11 @@ if is_64bit_system
   xcb_64bit_dep = dependency('xcb')
 endif
 if with_bitbridge
-  xcb_32bit_dep = winegcc.find_library('xcb')
+  # winegcc.find_library()'s compile-time link check always tests with the
+  # host compiler's default architecture (64-bit here, since this Wine's
+  # winegcc defaults to -m64), so it fails to "find" a 32-bit-only library
+  # even when it's right there - declare_dependency() sidesteps the test.
+  xcb_32bit_dep = declare_dependency(link_args: ['-L@libxcb32@/lib', '-lxcb'])
 endif
 
 # These are all headers-only libraries, and thus won't require separate 32-bit
